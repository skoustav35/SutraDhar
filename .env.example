# Frontend (Vite) — Supabase project
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>

# API serverless functions (api/*) — service role
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Optional: auto-restore for paused free-tier projects (api/db-wake.js)
FULLSTACK_PROJECT_REF=<project-ref>
FULLSTACK_RESTORE_API_URL=https://api.supabase.com/v1/projects/<project-ref>/restore
